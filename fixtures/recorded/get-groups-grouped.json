      {
       "title": "Jugend fährt nach Rom",
       "domainType": "group",
       "domainIdentifier": "37",
       "apiUrl": "https://gemeinde.example/api/groups/37",
       "frontendUrl": "https://gemeinde.example/groups/37",
       "imageUrl": "https://gemeinde.example/images/125/ac554937a9dbedea38df868ba65ff50ec47386cc6773c5c4a1f7be0cde84abb1",
       "icon": "users",
       "color": {
